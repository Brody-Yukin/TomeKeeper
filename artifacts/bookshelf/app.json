{
  "expo": {
    "name": "TomeKeeper",
    "slug": "tomekeeper",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tomekeeper",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071a2a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.tomekeeper.app"
    },
    "android": {
      "package": "com.tomekeeper.app"
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "TomeKeeper uses your camera to scan book barcodes and identify book covers."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
